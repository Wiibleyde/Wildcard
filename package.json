{
    "name": "wildcard",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:up": "bash scripts/dev-up.sh",
        "dev:down": "supabase stop",
        "dev:shared": "bun --env-file=.env.shared next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "lint:ci": "biome ci",
        "format": "biome format --write",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:rls": "bun --env-file=.env.local vitest run src/lib/supabase/rls.integration.test.ts",
        "db:reset": "supabase db reset",
        "db:new-migration": "supabase migration new",
        "db:types": "supabase gen types typescript --local --schema wildcard",
        "db:apply:shared": "bash scripts/apply-shared.sh",
        "docker:build": "docker build -t wildcard-app:local ."
    },
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "@supabase/ssr": "0.12.7",
        "@supabase/supabase-js": "2.117.2",
        "gsap": "^3.15.0",
        "next": "16.3.8",
        "next-intl": "^4.14.8",
        "prom-client": "^15.1.3",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "babel-plugin-react-compiler": "1.0.0",
        "playwright": "^1.63.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
