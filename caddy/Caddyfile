# ─────────────────────────────────────────────────────────────────────────────
# Wildcard — reverse proxy Caddy
#
# Point d'entrée HTTPS unique de la stack. Termine TLS avec des certificats
# Let's Encrypt émis et renouvelés automatiquement, puis route vers l'app
# Next.js et la gateway Supabase (Kong) par leur NOM DE SERVICE sur le réseau
# Docker interne — inutile de publier leurs ports hôte en production.
#
# Caddy gère nativement l'upgrade WebSocket (Realtime), la compression, et pose
# les en-têtes X-Forwarded-* : aucune directive manuelle nécessaire (≠ nginx).
#
# Variables injectées par docker-compose depuis .env.docker :
#   APP_DOMAIN, API_DOMAIN, ACME_EMAIL, CROWDSEC_API_KEY
#
# Sécurité : le handler `crowdsec` (module rebâti via caddy/Dockerfile) interroge
# la LAPI CrowdSec à chaque requête et bloque les IP sous décision. Les access
# logs JSON sont écrits dans le volume partagé `caddy-logs`, que l'agent CrowdSec
# parse pour DÉTECTER les attaques et créer ces décisions (boucle fermée).
# ─────────────────────────────────────────────────────────────────────────────
{
	# Email d'enregistrement ACME (notifications Let's Encrypt d'expiration).
	email {$ACME_EMAIL}

	# App CrowdSec : configure le client LAPI partagé par tous les handlers
	# `crowdsec`. api_key = même secret que BOUNCER_KEY_CADDY côté agent.
	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_API_KEY}
		ticker_interval 15s
	}
}

# Bloc réutilisable : access log JSON vers le volume partagé lu par CrowdSec.
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 30MiB
			roll_keep 5
		}
		format json
	}
}

# Application Next.js
{$APP_DOMAIN} {
	encode zstd gzip
	# `route` fige l'ordre : filtrage CrowdSec AVANT le proxy.
	route {
		crowdsec
		reverse_proxy app:3000
	}
	import access_log
}

# API Supabase (Kong) — REST (PostgREST), Auth (GoTrue), Realtime.
# L'upgrade WebSocket du Realtime est détecté et proxifié automatiquement.
{$API_DOMAIN} {
	encode zstd gzip
	route {
		crowdsec
		reverse_proxy kong:8000
	}
	import access_log
}

# ── Dashboards internes (optionnel) ──────────────────────────────────────────
# Décommenter et ajouter les domaines correspondants dans .env.docker pour
# exposer Studio / Grafana / Umami derrière le même proxy. Protéger l'accès
# (basicauth Caddy, VPN, ou IP allowlist) — ce sont des interfaces d'admin.
#
# studio.wildcard.example.com {
# 	reverse_proxy studio:3000
# }
# grafana.wildcard.example.com {
# 	reverse_proxy grafana:3000
# }
# umami.wildcard.example.com {
# 	reverse_proxy umami:3000
# }
