# ── Dev contre le Supabase PARTAGÉ (schéma wildcard_dev) ────────────────────
#   cp .env.shared.example .env.shared && bun run dev:shared
#
# Vraie auth (ES256), vraie RLS, vrais comptes — mais toujours sur localhost : le
# cookie partagé du portal ne peut pas s'y poser, donc connexion par
# /fr/dev-login avec un vrai compte email/mot de passe du portal.
# Schéma à créer / mettre à jour avec `bun run db:apply:shared` (cf. deploy/README.md).
SUPABASE_URL=https://supabase.wiibleyde.dev
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SCHEMA=wildcard_dev
SUPABASE_SECRET_KEY=sb_secret_...
APP_URL=http://localhost:3000
PORTAL_URL=
COOKIE_DOMAIN=
