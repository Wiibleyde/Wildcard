# ── Local dev — Supabase CLI (bun run dev:up) ───────────────────────────────
# Config publique lue au RUNTIME (src/lib/public-env.ts) — pas de NEXT_PUBLIC_*.
# Clés : `supabase status` (Publishable / Secret).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<Publishable key — supabase status>
SUPABASE_SCHEMA=wildcard

# Server-only — contourne la RLS (moteur de jeu : mains, graine RNG). Jamais
# exposée au navigateur.
SUPABASE_SECRET_KEY=<Secret key — supabase status>

# Pas de portal en local : la connexion passe par /fr/dev-login (comptes seedés,
# mot de passe password123). Cookie sans domaine (localhost).
APP_URL=http://localhost:3000
PORTAL_URL=
COOKIE_DOMAIN=

# Laisser vide en dev → /api/metrics répond 404 (fermé par défaut).
# METRICS_TOKEN=

# Umami : laisser vide en local.
UMAMI_URL=
UMAMI_WEBSITE_ID=
