# ~/infra/services/wildcard/.env — secrets masqués, à remplir sur le serveur.
WILDCARD_TAG=latest

# Mêmes valeurs que SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY de
# ~/infra/services/supabase/.env.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# postgresql://supabase_admin:<mot de passe>@db:5432/postgres
WILDCARD_DATABASE_URL=

# openssl rand -hex 32 — même valeur dans le fichier de token de Prometheus.
METRICS_TOKEN=

# ID du site « Wildcard » dans l'UI Umami (vide → pas de tag).
UMAMI_WEBSITE_ID=
